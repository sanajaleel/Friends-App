# Friends App Environment Variables

# Backend Port & Environment
PORT=4000
NODE_ENV=development

# Security & JWT Tokens
JWT_SECRET=super-secret-production-key-friends-app-32chars
JWT_EXPIRES_IN=7d

# Database & Cache
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/friends_app?schema=public
REDIS_URL=redis://localhost:6379

# SMS OTP Provider (MOCK for dev, TWILIO for production)
SMS_PROVIDER=MOCK
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WebRTC STUN / TURN Server Configuration
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=friendsuser
TURN_PASSWORD=friendspassword

# Payment Gateway (STRIPE / MOCK)
PAYMENT_GATEWAY=MOCK
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

